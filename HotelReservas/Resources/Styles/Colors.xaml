    <Color x:Key="Primary">#0B2A5B</Color>
    <Color x:Key="PrimaryDark">#071C3D</Color>
    <Color x:Key="Secondary">#1F6B3D</Color>
    <Color x:Key="Accent">#E8821A</Color>
